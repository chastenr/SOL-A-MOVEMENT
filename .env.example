# Public site URL, used for metadata, canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.veorawellness.com

# Where new booking and contact form notifications are sent. Never exposed to the browser.
OWNER_BOOKING_EMAIL=owner@example.com

# Resend (https://resend.com) — used to send booking and contact emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Veora Wellness <bookings@veorawellness.com>

# Supabase — required for accounts, packages, payments and booking. The
# guest /api/book flow still degrades gracefully to email-only if unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo — not yet used. Placeholders only; the payment provider
# abstraction (src/lib/payments) stays on manual_bank_transfer until these
# are set and the paymongo provider is implemented.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
