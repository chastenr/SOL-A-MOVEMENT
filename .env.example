# Public site URL, used for metadata, canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.soleamovement.com

# Where new booking and contact form notifications are sent. Never exposed to the browser.
OWNER_BOOKING_EMAIL=owner@example.com

# Resend (https://resend.com) — used to send booking and contact emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SOLÉA Movement & Wellness <bookings@soleamovement.com>

# Supabase — optional. When unset, booking storage and double-booking checks are
# skipped and the site runs on email notifications only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
