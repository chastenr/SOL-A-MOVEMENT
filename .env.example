# Public site URL, used for metadata, canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.veorawellnessph.com

# Last-resort fallback only — if BOOKING_NOTIFICATION_EMAIL or the owner
# addresses below are ever left blank, mail routes here instead of going
# nowhere. Not meant to be anyone's primary inbox anymore.
OWNER_BOOKING_EMAIL=owner@example.com

# Routine member booking traffic. Kept separate from the owner addresses
# below so day-to-day booking volume
# doesn't compete with payment/inquiry decisions for attention.
BOOKING_NOTIFICATION_EMAIL=bookings@veorawellnessph.com

# Anything needing an owner's judgment call — a payment proof to approve or
# reject, a contact-form inquiry. Sent to both when both are set.
OWNER_NOTIFICATION_EMAIL=bianca@veorawellnessph.com
ASHLEY_NOTIFICATION_EMAIL=ashley@veorawellnessph.com

# Resend (https://resend.com) — used to send booking and contact emails.
# Requires veorawellnessph.com to be a verified sending domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Veora Wellness <bookings@veorawellnessph.com>

# Supabase — required for accounts, packages, payments and booking. The
# Member booking and purchase data requires these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secures the automatic 10 PM attendance-check job (src/app/api/cron/check-
# attendance, scheduled in vercel.json). Set this to any random string in
# Vercel and Vercel automatically sends it as a Bearer token when it
# triggers the cron — that's how the route knows the request is really from
# Vercel and not a random visitor who found the URL. This job ALSO needs
# SUPABASE_SERVICE_ROLE_KEY above (it has no logged-in admin to authenticate
# as) — without both set, cancelled/confirmed classes just won't happen
# automatically yet; nothing breaks, it just stays manual.
CRON_SECRET=

# PayMongo — not yet used. Placeholders only; the payment provider
# abstraction (src/lib/payments) stays on manual_bank_transfer until these
# are set and the paymongo provider is implemented.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Phone verification / admin MFA — both default to false (unset). Real SMS
# delivery requires an SMS provider configured in the Supabase dashboard
# under Authentication -> Providers -> Phone (e.g. Twilio) FIRST. Flipping
# either flag to "true" before that just makes the gate visibly fail with a
# clear error — it never silently treats a phone as verified.
PHONE_VERIFICATION_REQUIRED=false
ADMIN_MFA_REQUIRED=false

# Optional override for the pre-launch site password (see
# src/lib/site-lock.ts, which already has a default baked in — this env
# var only matters if you want to change the password without a code push).
SITE_PASSWORD=

# Semaphore (https://semaphore.co) — sends booking and class-status SMS
# notifications. Keep the API key server-side; never prefix it NEXT_PUBLIC_.
# The sender name must already be approved in the Semaphore dashboard. SMS
# remains disabled until both values are present.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
